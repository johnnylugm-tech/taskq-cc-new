[importlinter]
root_packages =
    taskq_api
    sqlalchemy
include_external_packages = True

# SAB architecture_constraints (FR-01).
# Enforced via import-linter contracts. Each contract maps to one SAB
# declaration. Exit 0 → score 100; any broken contract → score 0.
#
# Note: project source lives in `src/` and lint-imports runs with
# PYTHONPATH=src. Run from this directory: `lint-imports --verbose`.
#
# Constraint coverage:
#   - downward_only_layer_dependencies  → `layers` contract (api > repository > models).
#                                         The same contract also enforces the SAB's
#                                         no_circular_dependencies: any cycle would be an
#                                         upward edge, which the layers contract rejects.
#   - no_sqlalchemy_above_repository     → `forbidden` contract (api may not import sqlalchemy).
#   - models_sqlalchemy_orm_declarative_only
#                                       → `forbidden` contract (models may not import
#                                         sqlalchemy.sql / sqlalchemy.schema — those are
#                                         the non-ORM Core/Table surfaces).

# downward_only_layer_dependencies — api → repository → models.
# Also covers no_circular_dependencies: any cycle implies an upward edge,
# which this contract rejects.
[importlinter:contract:downward-only-layer-dependencies]
name = Downward-only layer dependencies (api → repository → models)
type = layers
layers =
    taskq_api.api
    taskq_api.repository
    taskq_api.models

# no_sqlalchemy_above_repository — nothing above the repository layer may
# import sqlalchemy. The composition root (`taskq_api.app`) and the api
# package (`taskq_api.api`, which covers `taskq_api.api.deps` and every
# other api submodule) are listed as source_modules so the
# forbidden-import contract reaches every module that touches HTTP
# request handling. The package root (`taskq_api/__init__.py`) is a
# docstring-only stub (no imports) so it does not need to be in
# source_modules; including the bare `taskq_api` package would over-
# reach and forbid the *repository* layer (which legitimately uses
# SQLAlchemy per FR-05 §3 AC-5.3) from importing it.
[importlinter:contract:no-sqlalchemy-above-repository]
name = No sqlalchemy imports above repository layer
type = forbidden
source_modules =
    taskq_api.app
    taskq_api.api
forbidden_modules =
    sqlalchemy

# models_sqlalchemy_orm_declarative_only — models must use declarative ORM,
# not raw SQL strings / core Table reflection. Enforced by forbidding the
# raw-SQL / core-Table submodules at the package boundary (treat each entry
# as a module rather than a package to keep import-linter from rejecting
# sub-packages of external packages).
[importlinter:contract:models-sqlalchemy-orm-declarative-only]
name = Models use sqlalchemy.orm only, never sqlalchemy.sql / .schema
type = forbidden
source_modules =
    taskq_api.models
forbidden_modules =
    sqlalchemy.sql
    sqlalchemy.schema
as_packages = False
