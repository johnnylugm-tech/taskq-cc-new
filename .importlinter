[importlinter]
root_package = taskq_api

[importlinter:contract:no_circular_dependencies]
name = no_circular_dependencies
type = layers
layers =
    taskq_api.app
    taskq_api.api
    taskq_api.repository
    taskq_api.models

[importlinter:contract:taskq_api_self_check]
name = taskq_api_self_check
type = forbidden
source_modules =
    taskq_api
forbidden_modules =
    taskq_api.app
    taskq_api.api
    taskq_api.repository
    taskq_api.models
as_packages = False