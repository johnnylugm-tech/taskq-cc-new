# Coverage configuration for the taskq-cc-new project.
#
# Migration scripts (FR-07) live under `03-development/src/migrations/`.
# ``test_fr07.py`` top-level-imports ``migrations.versions.v3_split_results``
# and exercises its upgrade()/downgrade() in-process via
# ``test_v3_upgrade_and_downgrade_executed_in_process``, so pytest-cov DOES
# track this module — the previous blanket omit was incorrect for FR-07's
# per-FR Gate 1 measurement (Round 76 station 2 fix).
#
# The other migration modules (v1_initial, v2_tags, env, __init__,
# script.py.mako) are still only loaded by the alembic subprocess and not
# by pytest — keep them omitted so the coverage denominator reflects only
# code the unit/integration test suite actually exercises.
[run]
omit =
    03-development/src/migrations/env.py
    03-development/src/migrations/script.py.mako
    03-development/src/migrations/versions/__init__.py
    03-development/src/migrations/versions/v1_initial.py
    03-development/src/migrations/versions/v2_tags.py
    03-development/src/taskq_api/__main__.py
    03-development/src/taskq_api/service/runner.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError