# taskq-api — environment configuration
# Copy to `.env` and edit for local development.
# All 12 `TASKQ_*` env vars are consumed by `taskq_api.config` (SPEC §5.1).
# `TASKQ_DB_URL` is redacted in logs per NFR-04.

# ── HTTP server ───────────────────────────────────────────────────────────
# Listen address; default is loopback — never expose 0.0.0.0 in production
# without a reverse proxy that handles TLS / auth.
TASKQ_HOST=127.0.0.1
TASKQ_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────
# SQLite for dev/test; PostgreSQL for production. The repository layer is
# the only one that parses this URL (NFR-06).
TASKQ_DB_URL=sqlite:///./taskq.db
TASKQ_DB_POOL_SIZE=5

# ── Logging ───────────────────────────────────────────────────────────────
TASKQ_LOG_LEVEL=INFO
TASKQ_LOG_FORMAT=json

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated allowlist. Empty value = reject all (CORS deny-by-default,
# NFR-02). Example: TASKQ_CORS_ORIGINS=https://app.example.com,https://admin.example.com
TASKQ_CORS_ORIGINS=

# ── Rate limiting (per-token token bucket, FR-05) ─────────────────────────
TASKQ_RATE_BURST=20
TASKQ_RATE_PER_SEC=10

# ── Subprocess / task execution (FR-02 / FR-08) ───────────────────────────
TASKQ_TASK_TIMEOUT=30

# ── Async runner (FR-08) ─────────────────────────────────────────────────
# Maximum concurrent subprocesses; surplus requests queue.
TASKQ_MAX_CONCURRENT=8
# Graceful drain budget on shutdown — tasks exceeding this are marked
# `interrupted`.
TASKQ_DRAIN_TIMEOUT=10